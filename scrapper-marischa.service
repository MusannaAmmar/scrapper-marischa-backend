[Unit]
Description=Scrapper Marischa Backend - FastAPI AI Agent & Web Scraping API
After=network.target

[Service]
User=buzz
Group=www-data
WorkingDirectory=/home/buzz/Documents/Projects/scrapper-marischa-backend
EnvironmentFile=/home/buzz/Documents/Projects/scrapper-marischa-backend/.env
ExecStart=/home/buzz/Documents/Projects/scrapper-marischa-backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scrapper-marischa

[Install]
WantedBy=multi-user.target
